# Read via AWS_CONFIG_FILE. Anything under 4 GiB is one PutObject; the largest file in the
# tree is 0.72 GB. A file past 4 GiB (R2's single-part limit is 4.995 GiB) goes up in
# 512 MiB parts.
[default]
retry_mode = standard
max_attempts = 10
s3 =
    multipart_threshold = 4GB
    multipart_chunksize = 512MB
    max_concurrent_requests = 32
